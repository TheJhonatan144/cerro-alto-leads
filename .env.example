# Copia este archivo como .env y completa los valores. Nunca subas tu .env.
# La URL y el token de la API de pacientes aparecen en la página de la prueba.
# URL http(s) sin credenciales ni consulta. Si la URL o el token quedan vacíos, el sistema
# arranca igual y los leads quedan con enriquecimiento=no_configurado.
API_PACIENTES_URL=
# Solo caracteres ASCII imprimibles, sin espacios. Nunca se registra en los logs.
API_PACIENTES_TOKEN=
# Solicitudes por minuto a la API de pacientes (limitador local). Entero de 1 a 30. Vacío = 25.
PACIENTES_LIMITE_POR_MIN=
# Páginas como máximo por consulta (3 elementos por página). Entero de 1 a 20. Vacío = 5.
PACIENTES_MAX_PAGINAS=
# Clasificación con LLM (opcional). Proveedor: none, gemini, anthropic u openai.
# Vacío = none: se clasifica solo con reglas. Si no es none, LLM_MODEL y LLM_API_KEY son
# obligatorios. Usa solo datos ficticios en desarrollo (ver D10 en DECISIONES.md).
LLM_PROVIDER=
# Nombre exacto del modelo según la documentación de tu proveedor (no hay valor por defecto).
LLM_MODEL=
# La key del LLM que uses para clasificar. Nunca se registra en los logs.
LLM_API_KEY=
# Timeout de lectura de cada petición al LLM, en segundos. Decimal de 2 a 30. Vacío = 10.
LLM_TIMEOUT_S=
# Confianza mínima del LLM para aceptar "basura" sin evidencia de las reglas. De 0.5 a 1. Vacío = 0.8.
LLM_CONFIANZA_BASURA=
# Ruta de la base SQLite. Vacío = data/leads.db (relativa a parte-a/).
DB_PATH=
# Tamaño máximo del cuerpo del webhook, en bytes. Entero de 4096 a 4194304. Vacío = 262144 (256 KiB).
# Un cuerpo mayor recibe 413 y no se guarda.
WEBHOOK_MAX_BYTES=
# Un valor fuera de rango o mal escrito impide arrancar (el error nombra la variable).
# Días hacia atrás para buscar duplicados de negocio. Entero de 1 a 90. Vacío = 7.
DUPLICADO_VENTANA_DIAS=
# Trabajador de la cola: 0 o 1. Vacío = activo (1); 0 lo apaga.
WORKER_ACTIVO=
# Segundos de espera cuando no hay trabajo. Decimal de 0.1 a 60. Vacío = 1.
WORKER_INTERVALO_S=
# Segundos que un trabajo queda reservado antes de darlo por abandonado. Entero de 10 a 3600. Vacío = 60.
TRABAJO_LEASE_S=
# Intentos antes de marcar un trabajo como fallido. Entero de 1 a 20. Vacío = 5.
TRABAJO_MAX_INTENTOS=
